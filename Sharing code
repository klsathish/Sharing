[HttpPost("automationlogin")]
public async Task<IActionResult> AutomationCheckLogin([FromBody] LoginRequest request)
{
    string username = string.Empty;

    var hasCredentials = !string.IsNullOrEmpty(request.Username)
                      && !string.IsNullOrEmpty(request.Password);

    if (hasCredentials)
    {
        if (string.Equals(_configuration["Automation:TestingUsername"], request.Username, StringComparison.OrdinalIgnoreCase) && _configuration["Automation:TestingPassword"] == request.Password)
        {
            username = request.Username!;
        }

        if (string.IsNullOrEmpty(username))
            return Unauthorized(new
            {
                UserName = request.Username,
                StatusMessage = SabicConstants.UnAuthorized,
                StatusCode = SabicConstants.UnAuthorizedStatusCode
            });
    }
